# Frontend (Vite) local env

# API base URL (required for frontend -> backend requests)
VITE_API_URL=http://localhost:8080

# Supabase client config (required if auth/project backend is enabled in UI)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_key_here

# Google OAuth web client id (required for Google login button)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id

# Optional preview UX tuning
VITE_PREVIEW_READY_TIMEOUT_MS=90000
VITE_PREVIEW_RUNNING_WITHOUT_URL_TIMEOUT_MS=15000
VITE_PREVIEW_SESSION_REUSE_MAX_AGE_MS=60000

# Optional: render preview via Canvas Host wrapper (debug/event stream UI)
# Keep false for default end-user UX.
VITE_USE_CANVAS_HOST_PREVIEW=false
